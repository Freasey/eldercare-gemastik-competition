# Salin ke family-app/.env lalu sesuaikan.
# Expo hanya membaca variabel berawalan EXPO_PUBLIC_ dan menanamkannya
# ke bundle saat build — jangan taruh secret di sini.

# Alamat backend Express (lihat ../backend).
#
# Emulator Android  : http://10.0.2.2:4000
# HP fisik + Expo Go: http://<IP-LAN-laptop>:4000   (contoh: http://192.168.1.7:4000)
# Setelah deploy    : https://<nama-app>.back4app.io
#
# Cari IP LAN dengan `ipconfig` (cari IPv4 Address di adapter Wi-Fi).
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Email akun keluarga untuk tombol "Masuk sebagai demo".
# Cocok dengan data dari `npm run db:seed` di backend.
EXPO_PUBLIC_DEV_LOGIN_EMAIL=keluarga.demo@caretaker.id
