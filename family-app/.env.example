# Pola dua file — keduanya di-ignore git, jadi tiap mesin punya sendiri.
#
#   .env         alamat "default", isi URL backend production
#   .env.local   override mesin ini, isi URL backend lokal — MENANG atas .env
#
# Sehari-hari .env.local aktif sehingga app menunjuk ke lokal. Mau uji ke
# production, rename .env.local jadi .env.local.off.
#
# PENTING: Expo hanya membaca variabel berawalan EXPO_PUBLIC_ dan MENANAMKANNYA
# ke bundle saat bundling, bukan membacanya saat runtime. Jadi:
#   1. jangan taruh secret di sini — nilainya bisa diekstrak dari APK
#   2. setiap kali menukar nilai, jalankan `npx expo start --clear`,
#      kalau tidak Metro masih memakai nilai lama
#
# Jangan pakai .env.production / NODE_ENV untuk ini — Expo tidak menyarankannya.

# --- salin ke .env ---
EXPO_PUBLIC_API_URL=https://<nama-app>.b4a.run

# --- salin ke .env.local ---
# Emulator Android  : http://10.0.2.2:4000
# HP fisik + Expo Go: http://<IP-LAN-laptop>:4000   (cari lewat `ipconfig`)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Hanya dipakai `signInAsDemo` (dev-login), yang mati di production.
# Tombol "Coba sebagai tamu" tidak memerlukan ini.
EXPO_PUBLIC_DEV_LOGIN_EMAIL=keluarga.demo@caretaker.id
