# Salin ke backend/.env lalu isi dari .env root project.
# JANGAN commit backend/.env.

NODE_ENV=development
PORT=4000

# Postgres (NeonDB)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
JWT_SECRET=ganti-dengan-random-32-byte-hex
JWT_EXPIRES_IN=30d

# Kredensial pemicu scheduler dari luar (POST /api/cron/tick).
# WAJIB diisi di deploy serverless: di sana tidak ada proses yang hidup terus,
# jadi tanpa ini sweep reminder terlewat tidak pernah jalan dan keluarga tidak
# pernah diberi tahu. Nilai yang sama dipasang sebagai secret CRON_SECRET di
# GitHub repo (Settings > Secrets > Actions), bersama API_URL.
# Bikin dengan: openssl rand -hex 32
CRON_SECRET=

# Login tamu (POST /api/auth/guest) fitur produk, selalu hidup termasuk di
# production. Tiap tamu dapat akun + data demo sendiri; yang tidak dipakai lagi
# dihapus otomatis setelah sekian hari. Tamu bisa naik jadi akun asli dengan
# login Google sambil membawa token tamunya.
GUEST_RETENTION_DAYS=7
GUEST_JWT_EXPIRES_IN=7d

# LLM
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.3-70b-versatile
# Fallback speech-to-text (POST /api/stt), dipakai app lansia saat pengenal
# suara bawaan HP gagal menangkap ucapan.
GROQ_STT_MODEL=whisper-large-v3-turbo

# Push notification FCM V1 (services/push.js). Isi SALAH SATU:
#
#   FIREBASE_FCM_SERVICE_ACCOUNT_JSON_PATH  path file JSON di disk (lokal)
#   FIREBASE_SERVICE_ACCOUNT_B64            isi file yang sama, di-base64 (deploy)
#
# Di Back4app tidak ada file yang bisa ditunjuk, jadi pakai yang base64. Bikin
# nilainya begini (jangan di-commit, jangan ditempel ke chat/issue):
#
#   node -e "console.log(require('fs').readFileSync('nama-file.json').toString('base64'))"
#
# Tanpa salah satunya, server tetap jalan hanya notifikasi ke HP keluarga yang
# tidak terkirim, dan /health akan menulis push: "belum dikonfigurasi".
FIREBASE_FCM_SERVICE_ACCOUNT_JSON_PATH=
FIREBASE_SERVICE_ACCOUNT_B64=

# LiveKit (server-side only)
LIVEKIT_URL=wss://xxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Zona waktu default untuk penjadwalan reminder
DEFAULT_TIMEZONE=Asia/Jakarta
