# Salin ke backend/.env lalu isi dari .env root project.
# JANGAN commit backend/.env.

NODE_ENV=development
PORT=4000

# Postgres (NeonDB)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Auth
GOOGLE_WEB_CLIENT_ID=xxxx.apps.googleusercontent.com
JWT_SECRET=ganti-dengan-random-32-byte-hex
JWT_EXPIRES_IN=30d

# Dev-only: izinkan POST /api/auth/dev-login tanpa Google ID token.
# WAJIB false/kosong di production.
ALLOW_DEV_LOGIN=true

# LLM
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama-3.3-70b-versatile

# LiveKit (server-side only)
LIVEKIT_URL=wss://xxx.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Zona waktu default untuk penjadwalan reminder
DEFAULT_TIMEZONE=Asia/Jakarta
