# Kredensial jangan pernah masuk git.
# Pola `.env.*` sengaja menyapu semua varian (.env.local, .env.vercel, ...)
# supaya file baru tidak perlu diingat satu per satu; hanya .env.example yang
# ditarik kembali karena memang tidak berisi nilai asli.
.env
.env.*
!.env.example
.cron-secret.txt
*firebase-adminsdk*.json
google-services.json
GoogleService-Info.plist

# Build APK lokal (build-apk.ps1)
build.env.ps1
dist/
# APK ditandatangani debug key bawaan Expo, jadi tidak ada keystore yang perlu
# dijaga. Pola ini tetap dipertahankan sebagai jaring pengaman kalau suatu saat
# ada yang membuat keystore sungguhan dan lupa menaruhnya di luar repo.
*.jks
*.keystore

node_modules/
*.log
.DS_Store

# Dibuat Vercel CLI saat `vercel link` memuat id project/org.
.vercel/

# Draf eksplorasi branding (logo/wordmark) — belum final, sengaja tidak masuk repo.
branding/
