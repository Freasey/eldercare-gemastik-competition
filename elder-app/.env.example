# Pola dua file, sama seperti family-app keduanya di-ignore git.
#
#   .env         alamat "default", isi URL backend production
#   .env.local   override mesin ini, isi URL backend lokal MENANG atas .env
#
# Expo hanya membaca variabel berawalan EXPO_PUBLIC_ dan MENANAMKANNYA ke
# bundle saat bundling. Jadi jangan taruh secret di sini, dan jalankan
# `npx expo start --clear` setiap kali nilainya diubah.

# Alamat `http://` hanya jalan di development build (varian debug). Build
# release memblokir cleartext HTTP, jadi APK yang dibagikan wajib `https://`.

# --- salin ke .env ---
EXPO_PUBLIC_API_URL=https://eldercare-gemastik-competition.vercel.app

# --- salin ke .env.local ---
# Emulator Android  : http://10.0.2.2:4000
# HP fisik          : http://<IP-LAN-laptop>:4000   (cari lewat `ipconfig`)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
