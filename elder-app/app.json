{
  "expo": {
    "name": "RawatLansia",
    "slug": "ai-caretaker-elder",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "aicaretaker",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f4f7f6",
    "android": {
      "package": "com.eldercare.elder",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#E8930C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Kamera dipakai sekali saja, untuk memindai kode dari aplikasi keluarga."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Mikrofon dipakai supaya Anda bisa berbicara dengan asisten.",
          "speechRecognitionPermission": "Digunakan untuk memahami ucapan Anda.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0e7c6b"
        }
      ],
      "@livekit/react-native-expo-plugin",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "cmakeVersion": "3.31.6"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8930C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
